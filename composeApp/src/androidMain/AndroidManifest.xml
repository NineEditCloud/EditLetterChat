<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/> <!--声明 网络权限-->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/> <!--声明访问网络状态信息权限，非危险 普通权限(安装时自动授予)-->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32"/> <!--写入存储空间权限 非私有存储路径的文件写入要用-->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/> <!--读取存储空间权限 非私有存储路径的文件读取要用-->

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon00"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon00"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppLauncher"
        android:name=".database.MyApp"
        android:usesCleartextTraffic="true">
        <!--icon为应用图标，label为应用标签，theme可为应用设定自定义主题(如无安卓软件默认启动背景图的主题) @android:style/Theme.Material.Light.NoActionBar是默认主题，
        name为获取安卓应用Context(上下文调用实例) 的类(若对应类不存在会闪退)，usesCleartextTraffic为允许HTTP请求(必须)-->
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:theme="@style/Theme.AppLauncher">
            <!--theme可为主活动设定自定义主题(如无安卓软件默认启动背景图的主题)-->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>